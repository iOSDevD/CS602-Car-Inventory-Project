<!doctype html>
<html>
<head>
    <title>CS602 Project</title>
</head>
<link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css" />
<link rel="stylesheet" type="text/css" href="/css/projectUtil.css" />
<script src="/js/bootstrap.js"></script>
<style>
    .bg-image-vertical {
        position: relative;
        overflow: hidden;
        background-repeat: no-repeat;
        background-position: right center;
        background-size: auto 100%;
    }

    @media (min-width: 1025px) {
        .h-custom-2 {
            height: 100%;
        }
    }
</style>
<body>
<section class="vh-100">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-8 text-black">

                <div class="px-5 ms-xl-4 pt-3">
                    <label class="display-5" style="color: #4abefc;">CS602 Project iOSDevD</label>
                </div>

                <div class="d-flex align-items-center h-custom-2 px-5 ms-xl-4 mt-5 pt-5 pt-xl-0 mt-xl-n5">

                    <form style="width: 23rem;" method="post">

                        <h3 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Log in</h3>

                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="text" id="userName" name="username" class="form-control form-control-lg" />
                            <label class="form-label" for="userName">Username</label>
                        </div>

                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="password" id="formPassword" name="password" class="form-control form-control-lg" />
                            <label class="form-label" for="formPassword">Password</label>
                        </div>

                        <div class="pt-1 mb-4">
                            <button data-mdb-button-init data-mdb-ripple-init class="btn btn-info btn-lg btn-block" type="submit">Login</button>
                        </div>

                    </form>

                </div>

            </div>
            <div class="col-sm-4 px-0 d-none d-sm-block bg-primary row-12" style="object-fit: cover; object-position: left;">
                <img src="rightPanelImage.jpg"
                     alt="Login image" class="w-100 vh-100" style="object-fit: cover; object-position: left;">
            </div>
        </div>
    </div>
</section>
</body>
</html>

<div class="row">
    <div class="{{this.viewData.quoteSubmittedAlertDisplayStyle}} alert alert-warning mt-2" role="alert">
        There is already a request submitted by you, Waiting for dealer to
        review your request.
    </div>
    <div class="col-8">
        <p><h1>{{this.viewData.title}}</h1></p>
        <img src="{{this.viewData.mainImage}}" class="rounded float-right mt-2 mb-2" alt="...">

        <h3>{{this.viewData.price}}</h3>
        <h4>{{this.viewData.miles}}</h4>

        <p>
            {{this.viewData.description}}
        </p>
        <div class="list-group">
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Engine</h5>
                <small>{{this.viewData.engine}}</small>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Drive</h5>
                <small>{{this.viewData.drive}}</small>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Mileage City</h5>
                <small>{{this.viewData.mileageCity}}</small>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Mileage Highway</h5>
                <small>{{this.viewData.mileageHighway}}</small>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Mileage Combined</h5>
                <small>{{this.viewData.mileageCombined}}</small>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Horsepower</h5>
                <small>{{this.viewData.horsePower}}</small>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Interior Color</h5>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{this.viewData.interiorColor}}"  class="bi bi-circle-fill" viewBox="0 0 16 16">
                    <circle stroke='#000000' strokeWidth='2' cx="8" cy="8" r="6"/>
                </svg>
            </div>
            <div class="list-group-item d-flex w-100 justify-content-between">
                <h5 class="mb-1">Exterior Color</h5>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{this.viewData.exteriorColor}}"  class="bi bi-circle-fill" viewBox="0 0 16 16">
                    <circle stroke='#000000' strokeWidth='2' cx="8" cy="8" r="6"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="col-4">
        <form method="post" class="pt-1">
            <div class="form-group pt-1">
                <label for="email">Email address</label>
                <input type="email" name="email" class="form-control" id="email" aria-describedby="emailHelp" placeholder="Enter email">
                <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
            </div>
            <div class="form-group pt-1 pb-3">
                <label for="note">Note To the Dealer</label>
                <textarea name="note" class="form-control is-invalid" id="note" rows="3" aria-describedby="noteToDealerHelp" maxlength="100" required></textarea>
                <div class="invalid-feedback">
                    Please enter note for the dealer
                </div>
                <small id="noteToDealerHelp" class="form-text text-muted">Max characters allowed is 100</small>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>